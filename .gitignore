# --- Environment Files ---
# Never commit real .env or .env.local files containing local secrets/ports
.env
.env.local
.env.*.local
*.env

# Always allow .env.example templates to be pushed to GitHub
!.env.example
!backend/.env.example
!frontend/.env.example

# --- Python Backend ---
venv/
backend/venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Next.js Frontend ---
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
