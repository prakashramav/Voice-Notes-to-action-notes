# URL where Ollama is running (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Primary Ollama model to use for action item extraction
# (e.g., llama3.2, llama3.1:8b, phi3)
OLLAMA_MODEL=llama3.2

# Default Faster-Whisper model size (tiny, base, small, medium)
DEFAULT_WHISPER_MODEL=base

# Backend server host and port
HOST=0.0.0.0
PORT=8000
